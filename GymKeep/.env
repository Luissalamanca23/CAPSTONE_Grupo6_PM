# Configuracion de PostgreSQL
POSTGRES_USER=gymkeep
POSTGRES_PASSWORD=gymkeep_password
POSTGRES_DB=gymkeep
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://gymkeep:gymkeep_password@localhost:5432/gymkeep

# Configuracion de MongoDB (eventos de IA, detecciones y telemetria de camaras)
MONGO_ROOT_USER=gymkeep
MONGO_ROOT_PASSWORD=gymkeep_mongo_password
MONGO_PORT=27017
MONGO_DB=gymkeep_ai
MONGO_URL=mongodb://gymkeep:gymkeep_mongo_password@localhost:27017/?authSource=admin

# Configuracion de MinIO / S3 (snapshots y clips de evidencia de camara)
MINIO_ROOT_USER=gymkeep
MINIO_ROOT_PASSWORD=gymkeep_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=gymkeep
S3_SECRET_KEY=gymkeep_minio_password
S3_BUCKET=gymkeep-evidencias
S3_REGION=us-east-1

# Entorno
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
