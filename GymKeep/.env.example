# Configuracion de PostgreSQL
POSTGRES_USER=gymkeep
POSTGRES_PASSWORD=gymkeep_password
POSTGRES_DB=gymkeep
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://gymkeep:gymkeep_password@localhost:5432/gymkeep

# Configuracion de MongoDB (eventos de IA, detecciones y telemetria de camaras)
MONGO_ROOT_USER=gymkeep
MONGO_ROOT_PASSWORD=gymkeep_mongo_password
MONGO_PORT=27017
MONGO_DB=gymkeep_ai
MONGO_URL=mongodb://gymkeep:gymkeep_mongo_password@localhost:27017/?authSource=admin

# Configuracion de MinIO / S3 (snapshots y clips de evidencia de camara)
MINIO_ROOT_USER=gymkeep
MINIO_ROOT_PASSWORD=gymkeep_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=gymkeep
S3_SECRET_KEY=gymkeep_minio_password
S3_BUCKET=gymkeep-evidencias
S3_REGION=us-east-1

# Entorno
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# PIN (4 a 6 digitos) para editar zonas y parametros del modulo de vision. Vacio = sin PIN.
VISION_PIN=

# Clave compartida con el pipeline de vision (cabecera X-Pipeline-Key). Toda la API exige
# sesion, asi que es lo que deja entrar al pipeline: cambiala si la API es accesible desde fuera.
VISION_PIPELINE_KEY=gymkeep-pipeline-local

# Inicio de sesion del panel (RUN + clave numerica). La primera cuenta se crea con crear-admin.bat.
# Secreto para firmar las sesiones; vacio = se genera solo y se guarda en la base de datos.
AUTH_SECRET=
# Duracion de la sesion en horas.
SESSION_HOURS=24
# Origenes extra del panel, separados por comas (localhost y Tailscale ya estan permitidos).
CORS_ORIGINS=

# Respaldo automatico diario de PostgreSQL y MongoDB (RNF-21). Hora en UTC: 06:00 UTC = 03:00 en Chile (verano).
RESPALDO_HORA_UTC=06:00
RESPALDO_RETENCION_DIAS=7
